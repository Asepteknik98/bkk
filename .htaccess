Options -Indexes
DirectoryIndex index.php

# Tolak akses HTTP ke sumber internal dan berkas tersembunyi.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(?:app|database|storage|docs)(?:/|$) - [F,L,NC]
    # Reserved private document locations must never become static public downloads.
    RewriteRule ^uploads/(?:mou|biaya-perjalanan|private)(?:/|$) - [F,L,NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [END]
</IfModule>

<FilesMatch "(?i)^(?:README\.md|.*\.(?:sql|log|ini|env|bak))$">
    Require all denied
</FilesMatch>
